# Every setting in csms/config.py can be overridden with a CSMS_ prefix.

# CSMS_DATABASE_PATH=./data/csms.db
# CSMS_PORT=9000
# CSMS_HOST=0.0.0.0

# Reject chargers whose identity is not already in the database (HTTP 404).
# Off by default so a new unit auto-provisions and shows up in the dashboard.
# CSMS_REJECT_UNKNOWN_CHARGE_POINTS=true

# How long to wait for a CALLRESULT before declaring the CALL timed out.
# CSMS_CALL_TIMEOUT_SECONDS=30

# Stack level for the 0 W pause profile. Must beat any load-management
# profile you install underneath it.
# CSMS_PAUSE_PROFILE_STACK_LEVEL=10

# --- simulator (simulator/main.py) ---
# SIM_CSMS_URL=ws://localhost:9000/ocpp
# SIM_IDENTITY=CP001
# SIM_CONTROL_PORT=9100
# SIM_SAMPLE_INTERVAL=5      # seconds between MeterValues
# SIM_TIME_SCALE=60          # 60 = one simulated minute per real second
